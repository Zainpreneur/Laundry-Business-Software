# SQLite (default, zero-config local dev)
DATABASE_URL="file:./dev.db"

# For Postgres in production, switch the provider in prisma/schema.prisma to
# "postgresql" and set DATABASE_URL to your connection string, e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/laundry"

PORT=4000
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:5173
